public Boolean companionPlants(String plant1, String plant2) {
    
    Set<String> plants = new Set<String>{
        'lettucecucumbers', 
        'cucumberslettuce', 
        'lettuceonions', 
        'onionslettuce ',
        'onionscarrots', 
        'carrotsonions',
        'onionstomatoes',
        'tomatoesonions'        
    };

    String plantSet = plant1+plant2;

    if (plants.contains(plantSet)) return true;

    return false;

}